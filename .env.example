# ── Hedera (testnet) ─────────────────────────────────────────────
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=302e...            # ED25519 DER private key of the treasury/operator
USDC_TOKEN_ID=0.0.xxxxxx              # HTS stablecoin used for disbursement (mint one if none)

# ── Anthropic (server-side document parsing) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── World ID ─────────────────────────────────────────────────────
NEXT_PUBLIC_WORLD_APP_ID=app_staging_...
NEXT_PUBLIC_WORLD_ACTION=collateralize-house

# ── Wallet (Hedera WalletConnect / Reown) ────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Sui / Walrus / Seal (testnet) ────────────────────────────────
SUI_NETWORK=testnet
SUI_SECRET_KEY=suiprivkey1...         # funds Walrus storage + acts as Seal signer
WALRUS_NETWORK=testnet
