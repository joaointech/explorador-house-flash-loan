# ── Sui (testnet) — settlement chain ─────────────────────────────
SUI_NETWORK=testnet
# The official fullnode dropped public JSON-RPC; use a working JSON-RPC endpoint.
SUI_RPC_URL=https://rpc-testnet.suiscan.xyz
SUI_SECRET_KEY=suiprivkey1...           # protocol treasury (holds the TreasuryCap + gas)
# Published bridge::house Move package + its TreasuryCap
BRIDGE_PACKAGE_ID=0x...
BRIDGE_TREASURY_CAP=0x...
HOUSE_COIN_TYPE=0x...::house::HOUSE
# Circle testnet USDC on Sui (disbursement falls back to SUI if the treasury holds none)
USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC

# ── Walrus + Seal (testnet) — reuses SUI_SECRET_KEY ──────────────
WALRUS_NETWORK=testnet
SEAL_PACKAGE_ID=                        # optional; enables real Seal threshold encryption (else AES-GCM)
SEAL_KEY_SERVER_IDS=                    # comma-separated Seal key-server object ids
SEAL_MASTER_KEY=                        # AES fallback key

# ── Privy (embedded Sui wallet) ──────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=               # dashboard.privy.io → your app id
PRIVY_APP_SECRET=                       # server-side only

# ── Anthropic (server-side doc parsing + treasury agent) ─────────
ANTHROPIC_API_KEY=sk-ant-...

# ── World ID ─────────────────────────────────────────────────────
NEXT_PUBLIC_WORLD_APP_ID=app_...        # real staging/prod app id (not app_staging_demo)
NEXT_PUBLIC_WORLD_ACTION=collateralize-house
