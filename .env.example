# ── Sui (testnet) — settlement chain ─────────────────────────────
SUI_NETWORK=testnet
# The official fullnode dropped public JSON-RPC; use a working JSON-RPC endpoint.
SUI_RPC_URL=https://rpc-testnet.suiscan.xyz
SUI_SECRET_KEY=suiprivkey1...           # protocol treasury (holds the TreasuryCap + gas)
# Published bridge Move package (house + eusd modules) + treasury caps
BRIDGE_PACKAGE_ID=0x...
BRIDGE_TREASURY_CAP=0x...              # HOUSE TreasuryCap
BRIDGE_POOL_ID=0x...                   # shared lending Pool (utilization → borrow rate); shared at publish
HOUSE_COIN_TYPE=0x...::house::HOUSE
# eUSD — our own mintable USD stablecoin (6 dp). Disbursements mint full-value amounts.
EUSD_TREASURY_CAP=0x...
EUSD_COIN_TYPE=0x...::eusd::EUSD
# Optional: Circle testnet USDC (used only if EUSD_TREASURY_CAP is unset)
# USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC

# ── Walrus + Seal (testnet) — reuses SUI_SECRET_KEY ──────────────
WALRUS_NETWORK=testnet
# Seal (real threshold encryption). Set SEAL_PACKAGE_ID to the package holding the
# seal_approve policy — use the bridge package's ORIGINAL id (type origin), e.g.
# 0xcc6803…; key servers default to Mysten's verified testnet servers.
SEAL_PACKAGE_ID=                        # -> real Seal encryption (else AES-GCM fallback)
SEAL_KEY_SERVER_IDS=                    # optional override; blank = Mysten testnet key servers
SEAL_MASTER_KEY=                        # AES fallback key
# Walrus uploads need WAL in the treasury (faucet). Without WAL, blobs are demo
# (Seal encryption still real); fund WAL so blob ids resolve on walruscan.

# ── Privy (embedded Sui wallet) ──────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=               # dashboard.privy.io → your app id
PRIVY_APP_SECRET=                       # server-side only

# ── AI (server-side doc parsing + treasury agent) ────────────────
# Set EITHER provider; whichever key is present is used (OpenAI preferred if both).
OPENAI_KEY=sk-...                       # OpenAI (Responses API, vision + PDF + structured output)
# OPENAI_MODEL=gpt-4o                    # optional override
ANTHROPIC_API_KEY=sk-ant-...            # Anthropic (Claude) alternative
# AI_PROVIDER=openai                     # optional: force "openai" or "anthropic"

# ── World ID (Identity Check + Selfie Check) ─────────────────────
# From the Developer Portal. Keep app_id, rp_id and signing_key together.
NEXT_PUBLIC_WORLD_APP_ID=app_...        # real staging/prod app id (not app_staging_demo)
WORLD_RP_ID=rp_...                      # SERVER ONLY — registered relying-party id
WORLD_RP_SIGNING_KEY=0x...              # SERVER ONLY — never expose to the client
# Two actions, one per credential (each rp_context signature covers one action).
NEXT_PUBLIC_WORLD_ACTION_IDENTITY=collateralize-house-identity
NEXT_PUBLIC_WORLD_ACTION_SELFIE=collateralize-house-selfie
# NEXT_PUBLIC_WORLD_SANDBOX=1           # dev testing without a World ID: skips the IDKit widget
                                         # entirely (no phone, no World App) and fakes both proofs
                                         # server-side; UI shows a loud SANDBOX badge
